# MaterialIQ Environment Variables Example
# Copy this file to .env or .env.local to configure environment-specific settings.

# Backend API Base URL (if connecting to external FastAPI / REST backend)
VITE_API_URL=http://localhost:8000

# Graph Database Connection (if connecting to Neo4j instance)
VITE_NEO4J_URI=bolt://localhost:7687
VITE_NEO4J_USER=neo4j
VITE_NEO4J_PASSWORD=

# Optional API Key
VITE_API_KEY=

